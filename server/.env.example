# ============================================
# Streaming Platform — Server Configuration
# ============================================
# Copy this file to .env and fill in your values.
# For Render: set these via Environment Variables in the Render dashboard.
# ============================================

# Server
PORT=4000
NODE_ENV=production

# Database (MongoDB Atlas / self-hosted)
# Get this from: MongoDB Atlas → Database → Connect → Connection string
#   mongodb+srv://<user>:<password>@cluster0.xxxxx.mongodb.net/streaming?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/streaming"

# Redis (for caching)
REDIS_URL="redis://localhost:6379"

# JWT Secrets (REQUIRED — generate 64+ character random strings)
# You can generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET="change-me-to-a-random-string-at-least-64-characters-long"
JWT_REFRESH_SECRET="change-me-to-another-random-string-at-least-64-characters-long"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="7d"

# Client URL (for CORS — set to your Render frontend URL in production)
CLIENT_URL="https://your-app.onrender.com"

# bcrypt
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# TMDB API (optional — for metadata enrichment)
TMDB_API_KEY=""

# Gemini AI (optional — for AI-powered recommendations)
GEMINI_API_KEY=""

# Email (optional — for password resets, etc.)
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="noreply@streaming.local"
